{
  "name": "odex-desktop",
  "productName": "Odex",
  "version": "0.1.2",
  "description": "Odex: a self-hosted coding agent desktop app for vLLM",
  "main": "out/main/index.js",
  "license": "Apache-2.0",
  "author": "The Odex Authors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "gen:types": "cd ../engine && cargo run -q -p odex-protocol --bin odex-codegen -- ../desktop/shared-types/src/generated",
    "build:engine": "cd ../engine && cargo build --release -p odex-engine -p odex-mock-vllm",
    "test:e2e": "playwright test",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "dist": "npm run prepare:engine && npm run build && electron-builder --publish never",
    "dist:win": "npm run prepare:engine && npm run build && electron-builder --win nsis appx --publish never",
    "dist:mac": "npm run prepare:engine && npm run build && electron-builder --mac dmg zip --publish never",
    "dist:linux": "npm run prepare:engine && npm run build && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@tanstack/react-virtual": "^3.14.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@45.2.3": true
  }
}
